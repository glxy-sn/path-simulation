<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Engine berjalan di 127.0.0.1:8765. Tanpa ini, sandbox memblokir SEMUA
	     koneksi keluar termasuk ke localhost, dan layar Riwayat menampilkan
	     "pastikan engine jalan di :8765" walau engine-nya sehat. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Hasil lari ditulis engine ke ~/Documents/crowdflow/run-<id>/, dan
	     engine memberi lokasinya sebagai file:// URL. Folder itu tidak pernah
	     lewat dialog pilih berkas, jadi tanpa pengecualian ini AVPlayer gagal
	     diam-diam dan panel video tampil hitam. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Documents/crowdflow/</string>
	</array>
</dict>
</plist>
